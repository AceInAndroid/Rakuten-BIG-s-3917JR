#!/sbin/sh

umask 022
OUTFD=$2
ZIPFILE=$3

ui_print() { echo "ui_print $1" >&$OUTFD; echo "ui_print" >&$OUTFD; }
abort() { ui_print "$1"; exit 1; }

[ -f /data/adb/magisk/util_functions.sh ] || abort "Magisk 20.4+ is required"
. /data/adb/magisk/util_functions.sh
[ "$MAGISK_VER_CODE" -ge 20400 ] || abort "Magisk 20.4+ is required"
install_module
exit 0
